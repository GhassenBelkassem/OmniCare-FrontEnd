{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": "883e7e43-e6eb-41e8-8cf3-a18491a902ab",
    "cache": {
      "enabled": false
    }
  },
  "newProjectRoot": "projects",
  "projects": {
    "omniCareDash": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "server": "src/main.server.ts",
            "ssr": {
              "entry": "src/server.ts"
            },
            "tsConfig": "tsconfig.app.json",
            "polyfills": ["src/polyfills/global.ts"],
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "**/*",
                "input": "src/assets",
                "output": "assets"
              }
            ],
            "styles": [
              "node_modules/@fontsource-variable/plus-jakarta-sans/index.css",
              "src/styles/vendor/ng-zorro-theme.less",
              "src/styles/vendor/spartan-tailwind.css",
              "src/styles.scss"
            ],
            "stylePreprocessorOptions": {
              "includePaths": ["src"]
            },
            "security": {
              "allowedHosts": []
            },
            "allowedCommonJsDependencies": ["@stomp/stompjs", "sockjs-client"]
          },
          "configurations": {
            "production": {
              "prerender": true,
              "styles": [
                "node_modules/@fontsource-variable/plus-jakarta-sans/index.css",
              "src/styles/vendor/ng-zorro-theme.less",
                "src/styles/vendor/spartan-tailwind.production.css",
                "src/styles.scss"
              ],
              "fileReplacements": [
                {
                  "replace": "src/app/development.routes.ts",
                  "with": "src/app/development.routes.production.ts"
                }
              ],
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "750kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "18kB",
                  "maximumError": "20kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "static-demo": {
              "outputMode": "static",
              "server": false,
              "ssr": false,
              "optimization": true,
              "extractLicenses": true,
              "outputPath": {
                "base": "dist/omniCareDash-static",
                "browser": ""
              },
              "styles": [
                "node_modules/@fontsource-variable/plus-jakarta-sans/index.css",
              "src/styles/vendor/ng-zorro-theme.less",
                "src/styles/vendor/spartan-tailwind.production.css",
                "src/styles.scss"
              ],
              "outputHashing": "all",
              "fileReplacements": [
                {
                  "replace": "src/app/core/auth/auth-mode.ts",
                  "with": "src/app/core/auth/auth-mode.static-demo.ts"
                },
                {
                  "replace": "src/app/core/http/application-http-interceptors.ts",
                  "with": "src/app/core/http/application-http-interceptors.static-demo.ts"
                },
                {
                  "replace": "src/app/core/config/app-mode.ts",
                  "with": "src/app/core/config/app-mode.static-demo.ts"
                },
                {
                  "replace": "src/app/shared/ui/sidebar/oc-sidebar.ts",
                  "with": "src/app/shared/ui/sidebar/oc-sidebar.static-demo.ts"
                },
                {
                  "replace": "src/app/features/doctor/doctor.routes.ts",
                  "with": "src/app/features/doctor/doctor.routes.static-demo.ts"
                },
                {
                  "replace": "src/app/core/realtime/realtime.service.ts",
                  "with": "src/app/core/realtime/realtime.service.static-demo.ts"
                },
                {
                  "replace": "src/app/development.routes.ts",
                  "with": "src/app/development.routes.production.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "omniCareDash:build:production"
            },
            "development": {
              "buildTarget": "omniCareDash:build:development"
            },
            "static-demo": {
              "buildTarget": "omniCareDash:build:static-demo"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "setupFiles": ["src/test-setup.ts"]
          }
        }
      }
    }
  }
}
