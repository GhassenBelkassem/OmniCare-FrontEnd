{
  "name": "omni-care-dash",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build && node tools/prepare-deployment.mjs",
    "build:ci": "ng build --configuration production && node tools/prepare-deployment.mjs",
    "build:static-demo": "ng build --configuration static-demo",
    "start:static-demo": "ng serve --configuration static-demo",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false",
    "test:e2e": "playwright test",
    "check:ui-boundaries": "node tools/check-ui-boundaries.mjs",
    "check": "npm run check:ui-boundaries && npm run test:ci && npm run build:ci"
  },
  "private": true,
  "packageManager": "npm@11.11.0",
  "dependencies": {
    "@angular/cdk": "21.2.14",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/animations": "21.2.19",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-server": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/ssr": "^21.2.20",
    "@stomp/stompjs": "^7.3.0",
    "@fullcalendar/angular": "7.1.1",
    "@spartan-ng/brain": "1.2.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "express": "^5.1.0",
    "fullcalendar": "7.1.1",
    "less": "^4.8.1",
    "luxon": "3.7.2",
    "ng-zorro-antd": "^21.3.3",
    "rxjs": "~7.8.0",
    "sockjs-client": "^1.6.1",
    "tailwind-merge": "3.3.1",
    "temporal-polyfill": "1.0.1",
    "tslib": "^2.3.0",
    "tw-animate-css": "1.4.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.20",
    "@angular/cli": "^21.2.20",
    "@angular/compiler-cli": "^21.2.0",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.2",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "@types/sockjs-client": "^1.5.4",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "tailwindcss": "4.3.2",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
