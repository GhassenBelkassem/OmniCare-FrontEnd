{
  "name": "omni-care-dash",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build && node tools/prepare-deployment.mjs",
    "build:ci": "ng build --configuration production && node tools/prepare-deployment.mjs",
    "build:static-demo": "ng build --configuration static-demo",
    "start:static-demo": "ng serve --configuration static-demo",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false",
    "test:step1": "ng test --watch=false --ts-config tsconfig.step1.spec.json --include src/app/core/auth/auth.service.spec.ts --include src/app/features/login/login-page.spec.ts --include src/app/features/doctor/doctor.routes.spec.ts --include src/app/features/doctor/patient-lookup-dialog.spec.ts",
    "test:step2": "ng test --watch=false --ts-config tsconfig.step2.spec.json --include src/app/core/auth/auth-token.store.spec.ts --include src/app/core/auth/auth-bootstrap.service.spec.ts --include src/app/core/auth/auth.service.spec.ts --include src/app/core/auth/auth.interceptor.spec.ts --include src/app/core/auth/auth.guards.spec.ts --include src/app/core/auth/session-termination.service.spec.ts --include src/app/core/realtime/realtime.service.spec.ts --include src/app/features/login/login-page.spec.ts",
    "test:step3": "ng test --watch=false --ts-config tsconfig.step3.spec.json --include src/app/core/http/app-http-error.spec.ts --include src/app/core/http/request-correlation.interceptor.spec.ts --include src/app/core/auth/auth.service.spec.ts --include src/app/core/auth/auth.interceptor.spec.ts --include src/app/features/login/invitation-api.service.spec.ts --include src/app/features/platform-admin/admin-api.service.spec.ts --include src/app/features/platform-admin/admin-page-utils.spec.ts --include src/app/features/platform-admin/admin-idempotency.spec.ts --include src/app/features/doctor/scheduled-care/scheduled-care-errors.spec.ts --include src/app/features/doctor/scheduled-care/scheduled-care.facade.spec.ts",
    "test:step4": "ng test --watch=false --ts-config tsconfig.step4.spec.json --include src/app/features/doctor/urgent-requests/urgent-requests-page.spec.ts --include src/app/features/doctor/calendar/calendar-event.adapter.spec.ts --include src/app/features/doctor/calendar/calendar-page.spec.ts --include src/app/features/doctor/settings/settings-page.spec.ts --include src/app/features/doctor/scheduled-care/scheduled-care.facade.spec.ts --include src/app/features/clinic/clinic-case.store.spec.ts --include src/app/features/clinic/clinic-context.store.spec.ts --include src/app/features/clinic/clinic-task.store.spec.ts",
    "test:step5": "ng test --watch=false --ts-config tsconfig.step5.spec.json --include src/app/app.routes.spec.ts --include src/app/development.routes.production.spec.ts --include src/app/shared/ui/button/oc-button.spec.ts --include src/app/shared/ui/status-badge/oc-status-badge.spec.ts --include src/app/shared/ui/confirm-dialog/oc-confirm-dialog.spec.ts --include src/app/shared/ui/dialog/oc-dialog.spec.ts --include src/app/shared/ui/sheet/oc-sheet.spec.ts --include src/app/shared/ui/page-header/oc-page-header.spec.ts",
    "test:e2e": "playwright test",
    "profile:doctor-runtime": "node tools/profile-doctor-runtime.mjs",
    "check:ui-boundaries": "node tools/check-ui-boundaries.mjs",
    "check:production-boundary": "node tools/check-production-boundaries.mjs",
    "check": "npm run check:ui-boundaries && npm run check:production-boundary && npm run test:ci && npm run build:ci"
  },
  "private": true,
  "packageManager": "npm@11.11.0",
  "dependencies": {
    "@angular/animations": "21.2.19",
    "@angular/cdk": "21.2.14",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-server": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/ssr": "^21.2.20",
    "@fontsource-variable/plus-jakarta-sans": "^5.2.8",
    "@fullcalendar/angular": "7.1.1",
    "@spartan-ng/brain": "1.2.0",
    "@stomp/stompjs": "^7.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "express": "^5.1.0",
    "fullcalendar": "7.1.1",
    "less": "^4.8.1",
    "luxon": "3.7.2",
    "ng-zorro-antd": "^21.3.3",
    "rxjs": "~7.8.0",
    "sockjs-client": "^1.6.1",
    "tailwind-merge": "3.3.1",
    "temporal-polyfill": "1.0.1",
    "tslib": "^2.3.0",
    "tw-animate-css": "1.4.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.20",
    "@angular/cli": "^21.2.20",
    "@angular/compiler-cli": "^21.2.0",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.2",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "@types/sockjs-client": "^1.5.4",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "tailwindcss": "4.3.2",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
